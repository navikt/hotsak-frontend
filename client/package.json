  "packageManager": "pnpm@12.4.2",
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@grafana/faro-web-sdk": "2.11.0",
    "@grafana/faro-web-tracing": "2.11.0",
    "@unleash/proxy-client-react": "6.0.1",
    "@unleash/toolbar": "1.2.1",
    "@mdxeditor/editor": "4.2.5",
    "@navikt/aksel-icons": "8.16.2",
    "@navikt/ds-css": "8.16.2",
    "@navikt/ds-react": "8.16.2",
    "@platejs/basic-nodes": "53.0.0",
    "@platejs/floating": "53.0.0",
    "@platejs/link": "53.3.5",
    "@platejs/list-classic": "53.0.0",
    "@platejs/markdown": "53.3.12",
    "@platejs/selection": "53.1.6",
    "@platejs/slate": "53.3.10",
    "@styled-icons/bootstrap": "10.47.0",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "debug": "4.4.3",
    "eventsource-client": "^1.2.0",
    "graphql-request": "7.4.0",
    "platejs": "53.3.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "6.1.5",
    "react-hook-form": "7.88.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.12.4",
    "react-router": "8.4.0",
    "slate": "0.126.2",
    "slate-dom": "0.126.0",
    "slate-history": "0.115.0",
    "slate-hyperscript": "0.127.0",
    "slate-react": "0.126.4",
    "stacktrace-js": "2.0.2",
    "swr": "2.5.1",
    "uuid": "14.0.2",
    "unleash-proxy-client": "3.8.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.1",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/debug": "^4.1.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@types/umami": "^2.10.1",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "dexie": "4.4.6",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "less": "^4.9.1",
    "msw": "^2.15.0",
    "oxlint": "^1.83.0",
    "prettier": "^3.9.7",
    "rimraf": "^6.1.3",
    "type-fest": "^5.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "dev": "vite",
    "tsc": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest --dir ./src",
    "test:ci": "vitest --run --dir ./src",
    "test:copilot": "cross-env VITE_ENV_DIR=.testenv vitest --run --dir ./src",
    "e2e": "playwright test",
    "e2e:copilot": "cross-env COPILOT_E2E=true VITE_API_PROXY=false VITE_GRUNNDATA_PROXY=false VITE_ALTERNATIVPRODUKTER_PROXY=false VITE_OBO_TOKEN=https://dummy VITE_API_URL=https://dummy VITE_GOTENBERG=false playwright test",
    "e2e:ui": "playwright test --ui",
    "codegen:grunndata": "graphql-codegen --config grunndata-codegen.yaml",
    "codegen:alternativprodukter": "graphql-codegen --config alternativprodukter-codegen.yaml",
    "codegen:all": "pnpm run codegen:grunndata && pnpm run codegen:alternativprodukter",
    "lint": "oxlint --quiet .",
    "prettier": "prettier -w ./src",
    "clean": "rimraf ./dist"
  },
  "msw": {
    "workerDirectory": "public"
  }
}
